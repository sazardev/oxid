#!/usr/bin/env bash
# Thorough guardrails — runs on every `git push`. This is the last local
# line of defense before code leaves the machine; CI re-runs the same
# checks authoritatively (hooks can be bypassed with --no-verify, CI can't).
# See CONTRIBUTING.md#guardrails.
set -uo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=.githooks/_lib.sh
source "$HOOK_DIR/_lib.sh"

ROOT="$(repo_root)"
cd "$ROOT" || exit 1

status=0
remote="$1"

echo "[>] pre-push checks (remote: $remote)"

# Determine the commit range being pushed, per-ref, so we only scan what's
# actually about to leave the machine (falls back to the whole local branch
# history against the remote-tracking ref if that's not resolvable).
range_for_ref() {
    local local_sha="$1" remote_sha="$2"
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # New branch/tag: compare against the merge-base with the default remote branch if we can find one.
        local base
        base=$(git merge-base "$local_sha" "origin/main" 2>/dev/null || true)
        [ -n "$base" ] && echo "$base..$local_sha" || echo "$local_sha"
    else
        echo "$remote_sha..$local_sha"
    fi
}

secret_scan_failed=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue # deleting a ref
    range=$(range_for_ref "$local_sha" "$remote_sha")
    if command -v gitleaks >/dev/null 2>&1; then
        if ! gitleaks detect --log-opts="$range" --redact --no-banner >/tmp/oxid-gitleaks-push.log 2>&1; then
            fail "gitleaks found a likely secret being pushed ($local_ref, range $range):"
            sed 's/^/    /' /tmp/oxid-gitleaks-push.log
            secret_scan_failed=1
        fi
    fi
done

if [ "$secret_scan_failed" -ne 0 ]; then
    status=1
else
    ok "gitleaks history scan (or gitleaks not installed — see CONTRIBUTING.md#guardrails)"
fi

echo
info "cargo fmt --check ..."
if cargo fmt --all -- --check; then ok "cargo fmt --check"; else fail "cargo fmt --check"; status=1; fi

echo
info "cargo clippy (denying warnings for this check only) ..."
if cargo clippy --workspace --all-targets -- -D warnings; then
    ok "cargo clippy"
else
    fail "cargo clippy reported warnings/errors"
    status=1
fi

echo
info "oxid-core hexagonal boundary ..."
if check_hexagonal_boundary "$ROOT"; then ok "oxid-core dependency boundary"; else status=1; fi

echo
info "cargo test --workspace ..."
if cargo test --workspace; then ok "cargo test --workspace"; else fail "cargo test --workspace"; status=1; fi

echo
if command -v cargo-audit >/dev/null 2>&1 || cargo audit --version >/dev/null 2>&1; then
    info "cargo audit (RustSec advisory DB) ..."
    if cargo audit; then ok "cargo audit"; else fail "cargo audit found vulnerable/yanked dependencies"; status=1; fi
else
    warn "cargo-audit not installed — skipping dependency vulnerability scan locally (CI still runs it)."
    warn "Install with: cargo install cargo-audit --locked"
fi

echo
if command -v cargo-deny >/dev/null 2>&1 || cargo deny --version >/dev/null 2>&1; then
    info "cargo deny check (licenses, bans, advisories, sources) ..."
    if cargo deny check; then ok "cargo deny check"; else fail "cargo deny check failed"; status=1; fi
else
    warn "cargo-deny not installed — skipping license/supply-chain check locally (CI still runs it)."
    warn "Install with: cargo install cargo-deny --locked"
fi

if [ "$status" -ne 0 ]; then
    echo
    die "pre-push checks failed"
fi

ok "pre-push checks passed"
exit 0
