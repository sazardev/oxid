# Optional — the shipped docker-compose.yml runs with OXID_AUTO_TOKEN=1 and
# generates both secrets on first start (printed once to the daemon logs,
# persisted under /data). Copy this file and fill in your own values only if
# you want to pin them explicitly.
#
#   OXID_API_TOKEN       authenticates the CLI/dashboard against the daemon
#   OXID_WEBHOOK_SECRET  verifies GitHub/GitLab/Gitea/Gogs webhook signatures
#
# Generate each with:  openssl rand -hex 32
OXID_API_TOKEN=change-me
OXID_WEBHOOK_SECRET=change-me
