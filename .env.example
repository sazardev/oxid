# Copy to `.env` next to docker-compose.yml (install.sh --docker does this
# for you and generates both secrets). Required — the daemon refuses to
# start without a token on a non-loopback bind.
#
#   OXID_API_TOKEN       authenticates the CLI/dashboard against the daemon
#   OXID_WEBHOOK_SECRET  verifies GitHub/GitLab/Gitea/Gogs webhook signatures
#
# Generate each with:  openssl rand -hex 32
OXID_API_TOKEN=change-me
OXID_WEBHOOK_SECRET=change-me
